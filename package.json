{
  "name": "parkkal-dental",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply parkkal-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply parkkal-db --remote",
    "db:studio": "drizzle-kit studio",
    "db:setup:local": "node scripts/setup-local-db.js"
  },
  "dependencies": {
    "next": "^15.3.3",
    "react": "^18",
    "react-dom": "^18",
    "drizzle-orm": "^0.33.0",
    "@cloudflare/workers-types": "^4.20240909.0",
    "@opennextjs/cloudflare": "^1.3.0",
    "jose": "^5.9.3",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.2",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.441.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/bcryptjs": "^2.4.6",
    "tailwindcss": "^3.4.1",
    "autoprefixer": "^10.0.1",
    "postcss": "^8",
    "drizzle-kit": "^0.24.0",
    "@libsql/client": "^0.14.0",
    "wrangler": "^4.86.0",
