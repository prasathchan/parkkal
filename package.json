{
  "name": "parkkal-dental",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare build && wrangler d1 migrations apply parkkal-db --env=prod --remote && wrangler deploy --env=prod",
    "cf:deploy:staging": "opennextjs-cloudflare build && wrangler d1 migrations apply parkkal-db-staging --env=staging --remote && wrangler deploy --env=staging",
    "cf:rollback": "wrangler rollback --env=prod",
    "cf:rollback:staging": "wrangler rollback --env=staging",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply parkkal-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply parkkal-db --remote",
    "db:studio": "drizzle-kit studio",
    "db:setup:local": "node scripts/setup-local-db.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "load:smoke": "k6 run load-tests/smoke.js",
    "load:api": "k6 run load-tests/api.js",
    "load:spike": "k6 run load-tests/spike.js"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@opennextjs/cloudflare": "^1.3.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^5.9.3",
    "lucide-react": "^0.441.0",
    "next": "^15.5.19",
    "pdf-lib": "^1.17.1",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^2.5.2",
    "twilio": "^6.0.2",
    "zod": "^3.23.8"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@libsql/client": "^0.14.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8",
    "eslint-config-next": "^15.3.3",
    "happy-dom": "^20.10.2",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.10",
    "wrangler": "^4.100.0"
  }
}
